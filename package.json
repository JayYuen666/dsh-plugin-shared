{
  "name": "@jayyuen66/dsh-plugin-shared",
  "version": "0.3.0",
  "description": "dsh 自研插件的共享工具库：tool 事件流记账、卡片草稿/差异/UI 组件、项目键与 locale、作业结局、路径/数值/CLI 安全与代理对安全截断等跨仓公共件。宿主半由各插件 import；客户端半以 ./client 共享行由插件 patch 启用，该供应行必须保持开启——停用后各插件设置卡会失去组件供应",
  "keywords": [
    "cordis",
    "dsh",
    "plugin",
    "settings-card",
    "tool-events"
  ],
  "homepage": "https://github.com/JayYuen666/dsh-plugin-shared#readme",
  "bugs": {
    "url": "https://github.com/JayYuen666/dsh-plugin-shared/issues"
  },
  "license": "MIT",
  "author": "JayYuen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayYuen666/dsh-plugin-shared.git"
  },
  "files": [
    "icon.svg",
    "dist",
    "config/*.json",
    "README.zh-CN.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/plugin.js",
  "types": "./dist/types/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./client": {
      "types": "./dist/types/client-entry.d.ts",
      "node": "./dist/client-entry.js",
      "import": "./dist/client-entry.js",
      "default": "./dist/client.js"
    },
    "./tool": {
      "types": "./dist/types/tool.d.ts",
      "browser": "./dist/tool-browser.js",
      "default": "./dist/tool.js"
    },
    "./internal/tool/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    },
    "./lib/canonicalize-region-paths": {
      "types": "./dist/types/canonicalize-region-paths.d.ts",
      "default": "./dist/canonicalize-region-paths.js"
    },
    "./lib/build-artifacts": {
      "types": "./dist/types/build-artifacts.d.ts",
      "default": "./dist/build/build-artifacts.js"
    },
    "./lib/build-host": {
      "types": "./dist/types/build-host.d.ts",
      "default": "./dist/build/build-host.js"
    },
    "./lib/build-client": {
      "types": "./dist/types/build-client.d.ts",
      "default": "./dist/build/build-client.js"
    },
    "./lib/build-types": {
      "types": "./dist/types/build-types.d.ts",
      "default": "./dist/build/build-types.js"
    },
    "./lib/build-tool-imports": {
      "types": "./dist/types/build-tool-imports.d.ts",
      "default": "./dist/build/build-tool-imports.js"
    },
    "./lib/decorator-lowering": {
      "types": "./dist/types/decorator-lowering.d.ts",
      "default": "./dist/build/decorator-lowering.js"
    },
    "./config/oxlint": {
      "types": "./dist/types/config/oxlint.base.d.ts",
      "default": "./dist/config/oxlint.base.js"
    },
    "./config/vitest.base": {
      "types": "./dist/types/config/vitest.base.d.ts",
      "default": "./dist/config/vitest.base.js"
    },
    "./config/tsconfig.base.json": "./config/tsconfig.base.json",
    "./config/tsconfig.client.base.json": "./config/tsconfig.client.base.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node build-clean.mjs && node build-host.mjs && node build-config.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.build.config.json && node build-types-check.mjs && node build-client.mjs",
    "build:client": "node build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "test": "vitest run --coverage",
    "check": "npm run --loglevel=warn typecheck && npm run --loglevel=warn lint && npm run --loglevel=warn build && npm run --loglevel=warn test && npm run --loglevel=warn fmt:check",
    "fmt:check": "oxfmt --check .",
    "fmt": "oxfmt .",
    "prepare": "npm run --loglevel=warn build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs-patch": "0.2.3-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-brand": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-error": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-output-retention": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-shell": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.3-alpha.2",
    "@e18e/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-zod": "catalog:",
    "fast-check": "4.11.0",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.2.0-alpha.1",
    "@deepseek-ai/dsh": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-jobs": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-output-retention": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-shell": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-executor-ptc": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.3-alpha.2",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-output-retention": {
      "optional": false
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-executor-ptc": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "icon": "icon.svg",
  "engines": {
    "dsh": "^0.2.3-alpha.2",
    "node": "^24.22.3 || >=26.13.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
