{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/types",
    "rootDir": "lib",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["test/**/*.ts", "lib/index.ts"]
}
